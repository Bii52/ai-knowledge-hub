# Environment Configuration for AI Knowledge Hub API

# Server
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_knowledge_hub?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-jwt-access-key-ai-knowledge-hub"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-ai-knowledge-hub"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 / MinIO Object Storage
STORAGE_ENDPOINT="localhost"
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET_NAME="ai-knowledge-hub"

# AI Service Connection
AI_SERVICE_URL="http://localhost:8000"
